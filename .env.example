# Anthropic — the Evaluator and Repairer agents (claude-opus-5), and the two steps of the
# Mentic pipeline this repo reproduces: the actor-image doctrine call and the vision
# describe call, both on claude-sonnet-5 because that is what Mentic runs them on.
ANTHROPIC_API_KEY=

# OpenAI — used only by the cross-provider bias check (`npm run bias`)
OPENAI_API_KEY=

# Google AI Studio — Nano Banana Pro (gemini-3-pro-image), which renders the character
# reference sheet. Same variable name Mentic reads. Without it the app still grades
# descriptions; `POST /avatar/sheet` answers 503 and the Pipeline tab says so.
# GOOGLE_API_KEY is accepted as a fallback, as in Mentic.
GOOGLE_AI_KEY=

# Set to 1 to run the live API tests, which are skipped by default
RUN_LIVE_API=0
